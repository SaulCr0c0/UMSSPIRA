            "exec": [
              "pm.test('Responde 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('Es la carrera del administrador', () => pm.expect(body.careerName).to.eql('Ingeniería de Sistemas'));",
              "pm.test('Trae sólo los titulados de esa carrera', () => pm.expect(body.total).to.eql(72));",
              "pm.test('No mezcla titulados de la otra carrera', () => pm.expect(body.graduates.map((g) => g.fullName)).to.not.include('Alcócer Vargas, Daniela Sofía'));"
