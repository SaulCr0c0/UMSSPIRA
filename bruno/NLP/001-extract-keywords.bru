meta {
  name: Extraer keywords
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/nlp/extract
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "text": "Node.JS y nodejs\nC++ y C#\nCI/CD\nAmazon Web Services (AWS)\nGobierno de TI\nObservabilidad"
  }
}

tests {
  test("Estado 200", function() {
    expect(res.status).to.equal(200);
  });

  test("Esquema data", function() {
    const body = res.getBody();
    expect(body.data).to.be.an("object");
    expect(body.data.keywords).to.be.an("array");
    expect(body.data.unmapped).to.be.an("array");
    [...body.data.keywords, ...body.data.unmapped].forEach(function(item) {
      expect(item.term).to.be.a("string");
      expect(item.term.length).to.be.above(0);
      expect(item.count).to.be.a("number");
      expect(item.count).to.be.above(0);
    });
  });

  test("Resuelve variantes de Node.js", function() {
    const body = res.getBody();
    const item = body.data.keywords.find(function(keyword) {
      return keyword.term === "node.js";
    });
    expect(item.count).to.equal(2);
  });

  test("Conserva símbolos técnicos", function() {
    const body = res.getBody();
    const terms = body.data.keywords.map(function(keyword) {
      return keyword.term;
    });
    expect(terms).to.include("c++");
    expect(terms).to.include("c#");
    expect(terms).to.include("ci cd");
  });

  test("Consolida la misma mención", function() {
    const body = res.getBody();
    const item = body.data.keywords.find(function(keyword) {
      return keyword.term === "amazon web services";
    });
    expect(item.count).to.equal(1);
  });

  test("Devuelve no mapeadas", function() {
    const body = res.getBody();
    const item = body.data.unmapped.find(function(keyword) {
      return keyword.term === "observabilidad";
    });
    expect(item.count).to.equal(1);
  });
}

docs {
  Normaliza alias, símbolos y la misma mención; deja las palabras desconocidas en unmapped.

  Permiso: nlp:extract. Usa un token de titulado o administrador.
}
