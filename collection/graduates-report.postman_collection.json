  "item": [
    {
      "name": "200 - Titulados verificados",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Responde 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('Estado verified', () => pm.expect(body.status).to.eql('verified'));",
              "pm.test('Trae carrera, total y titulados', () => {",
              "  pm.expect(body.careerName).to.be.a('string').and.not.empty;",
              "  pm.expect(body.total).to.eql(body.graduates.length);",
              "  pm.expect(body.total).to.be.above(0);",
              "});",
              "pm.test('Cada titulado tiene los 9 datos', () => {",
              "  const keys = ['number','fullName','sisCode','phone','email','admissionDate','graduationDate','careerDuration','statusDate'];",
              "  body.graduates.forEach((g) => pm.expect(g).to.have.all.keys(keys));",
              "});",
              "pm.test('Duración en años y meses', () => pm.expect(body.graduates[0].careerDuration).to.match(/^(\\d+ años?(, \\d+ mes(es)?)?|\\d+ mes(es)?|No disponible)$/));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/graduates-report?status=verified",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "graduates-report"
          ],
          "query": [
            {
              "key": "status",
              "value": "verified"
            }
          ]
        }
      }
    },
