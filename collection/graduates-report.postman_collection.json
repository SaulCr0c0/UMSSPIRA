    {
      "name": "PDF 200 - Reporte de verificados",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Responde 200', () => pm.response.to.have.status(200));",
              "pm.test('Es un PDF', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/pdf'));",
              "pm.test('Nombre reporte-titulados-verificados-AAAAMMDD.pdf', () => {",
              "  const disposition = pm.response.headers.get('Content-Disposition');",
              "  pm.expect(disposition).to.match(/filename=\"reporte-titulados-verificados-\\d{8}\\.pdf\"/);",
              "});",
              "pm.test('El nombre es visible para la web (CORS)', () => pm.expect(pm.response.headers.get('Access-Control-Expose-Headers') || '').to.include('Content-Disposition'));",
              "pm.test('El archivo empieza como PDF', () => pm.expect(pm.response.stream.toString('latin1', 0, 5)).to.eql('%PDF-'));"
            ]
          }
        }
      ],
