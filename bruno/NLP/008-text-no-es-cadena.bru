meta {
  name: Text no es cadena
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/api/v1/nlp/extract
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "text": 42
  }
}

tests {
  test("Estado 400", function() {
    expect(res.status).to.equal(400);
  });

  test("Esquema de error", function() {
    const body = res.getBody();
    expect(body.error).to.be.an("object");
    expect(body.error.code).to.be.a("string");
    expect(body.error.code.length).to.be.above(0);
    expect(body.error.message).to.be.a("string");
    expect(body.error.message.length).to.be.above(0);
  });

  test("Código VALIDATION_ERROR", function() {
    const body = res.getBody();
    expect(body.error.code).to.equal("VALIDATION_ERROR");
  });
}

docs {
  text debe ser una cadena; un número responde 400.
}
