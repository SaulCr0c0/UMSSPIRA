        {
          "name": "Restablecer perfiles demo",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/mentorship/profiles/reset"
          }
        },
        {
          "name": "Consultar mi perfil",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('La respuesta incluye el estado del mentor', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json()).to.have.property('esta_activo');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "description": "Devuelve la fila mentor del usuario autenticado (id, experiencia, esta_activo, anios_exp y fechas). Si el mentor aún no existe, devuelve 404.",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": "{{baseUrl}}/mentorship/my-profile"
          }
        },
        {
          "name": "Configurar participación del mentor",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('La participación del mentor se actualiza', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json()).to.have.property('esta_activo');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "description": "Activa o desactiva la participación como mentor (HU 6.1). esta_activo es obligatorio; experiencia y anios_exp son opcionales. anios_exp acepta valores de 0 a 80.",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"esta_activo\": true,\n  \"experiencia\": \"Apoyo en backend con Node.js y buenas prácticas de código.\",\n  \"anios_exp\": 4\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/mentorship/my-profile/participation"
          }
        },
        {
          "name": "Consultar áreas técnicas",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('La respuesta incluye las áreas seleccionadas', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json()).to.have.property('selectedIds');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "description": "Devuelve las áreas raíz activas, las seleccionadas por el mentor (selectedIds) y, si el backend ya las informa, los intereses dependientes.",
