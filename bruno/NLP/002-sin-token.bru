meta {
  name: Sin token
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/nlp/extract
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "text": "JavaScript"
  }
}

tests {
  test("Estado 401", function() {
    expect(res.status).to.equal(401);
  });

  test("Esquema de error", function() {
    const body = res.getBody();
    expect(body.error).to.be.an("object");
    expect(body.error.code).to.be.a("string");
    expect(body.error.code.length).to.be.above(0);
    expect(body.error.message).to.be.a("string");
    expect(body.error.message.length).to.be.above(0);
  });

  test("Código UNAUTHENTICATED", function() {
    const body = res.getBody();
    expect(body.error.code).to.equal("UNAUTHENTICATED");
  });
}

docs {
  Sin Authorization debe responder 401.
}
