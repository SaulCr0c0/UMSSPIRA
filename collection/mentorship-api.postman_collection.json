                "type": "text/javascript",
                "exec": [
                  "pm.test('El perfil con restricciones no es elegible', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const result = pm.response.json();",
                  "  pm.expect(result.eligible).to.eql(false);",
