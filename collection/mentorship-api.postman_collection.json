          ],
          "request": {
            "method": "DELETE",
            "description": "Elimina un interés del mentor (HU 6.3). El parámetro interestId es el UUID del área que representa el interés (no del área raíz).",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": "{{baseUrl}}/mentorship/interests/{{interestId}}"
          }
        }
      ]
    }
  ]
}
