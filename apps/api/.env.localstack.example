# PLANTILLA. Para usar el stack local de Docker como respaldo:
#   1. cp apps/api/.env.localstack.example apps/api/.env.localstack
#   2. npx supabase status   -> copiar el valor de SECRET_KEY en la linea de abajo
#
# Estas claves las genera el CLI en cada maquina: son de desarrollo, cambian siempre
# y NO sirven para la nube. Por eso el archivo real queda fuera de Git
# (ver .gitignore) y en su lugar se versiona esta plantilla.

SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=pegar-aqui-el-SECRET_KEY-de-supabase-status
