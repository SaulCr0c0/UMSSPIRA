              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));",
                  "const { data } = pm.response.json();",
                  "pm.test('Trae datos y documento', () => { pm.expect(data.fullName).to.be.a('string'); pm.expect(data).to.have.property('documentPath'); });"
                ]
              }
            }
          ],
          "request": {
