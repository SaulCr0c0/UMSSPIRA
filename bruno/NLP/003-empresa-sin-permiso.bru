meta {
  name: Empresa sin permiso
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/nlp/extract
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "text": "JavaScript"
  }
}

tests {
  test("Estado 403", function() {
    expect(res.status).to.equal(403);
  });

  test("Esquema de error", function() {
    const body = res.getBody();
    expect(body.error).to.be.an("object");
    expect(body.error.code).to.be.a("string");
    expect(body.error.code.length).to.be.above(0);
    expect(body.error.message).to.be.a("string");
    expect(body.error.message.length).to.be.above(0);
  });

  test("Código FORBIDDEN", function() {
    const body = res.getBody();
    expect(body.error.code).to.equal("FORBIDDEN");
  });
}

docs {
  Usa el accessToken de empresa@umss.edu.bo. El rol empresa no tiene nlp:extract y debe recibir 403.
}
