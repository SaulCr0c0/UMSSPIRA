{
  "name": "api",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "nest start --watch",
    "dev:local": "SUPABASE_ENV=local nest start --watch",
    "build": "nest build",
    "test:interests": "npm run build && node --test test/mentorship-interests.e2e.cjs",
    "test:profile-info": "npm run build && node --test test/mentorship-profile-information.test.cjs",
    "lint": "eslint src --ext .ts",
    "start": "node dist/main",
    "test": "npm run build && npm run test:node && npm run test:jest",
    "test:node": "node --test \"dist/modules/reports/**/*.spec.js\"",
    "test:jest": "jest --config jest.config.js"
  },
  "dependencies": {
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^10.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "@supabase/supabase-js": "^2.117.2",
    "@umsspira/shared-types": "workspace:*",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^18.0.5",
    "multer": "^2.4.0",
    "pdfmake": "^0.2.23",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@types/express": "^5.0.6",
    "@types/jest": "29.5.14",
    "@types/multer": "^2.3.0",
    "@types/node": "^20.0.0",
    "@types/pdfmake": "^0.2.13",
    "@types/pg": "^8.23.1",
    "eslint": "^10.12.0",
    "jest": "29.7.0",
    "ts-jest": "29.2.5",
    "typescript": "^5.1.3",
    "typescript-eslint": "^8.71.0"
  }
}
