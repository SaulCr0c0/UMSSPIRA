meta {
  name: Extraer keywords - 400 Texto supera 5000 caracteres
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/v1/nlp/extract
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "text": ""
  }
}

tests {
  test("Status 400 por texto mayor a 5000 caracteres", function() {
    expect(res.status).to.equal(400);
  });

  test("Respuesta usa formato de error { error: { code, message } }", function() {
    expect(res.body).to.have.property("error").that.is.an("object");
    expect(res.body.error).to.have.property("message");
  });
}

docs {
  HU-1 · T1.7 — Texto de 5 001 caracteres (supera el límite).
  Debe responder 400 Bad Request con mensaje de validación.

  CA-HU5-19: texto > 5 000 caracteres → 400 Bad Request.
  Ver también test 007 que prueba exactamente 5 000 chars → 200 (límite inclusivo).

  Permiso: nlp:extract.
}
