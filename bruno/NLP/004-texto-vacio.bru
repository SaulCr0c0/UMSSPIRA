meta {
  name: Texto vacío
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/v1/nlp/extract
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "text": ""
  }
}

tests {
  test("Estado 200", function() {
    expect(res.status).to.equal(200);
  });

  test("Listas vacías", function() {
    const body = res.getBody();
    expect(body.data.keywords).to.deep.equal([]);
    expect(body.data.unmapped).to.deep.equal([]);
  });
}

docs {
  Un texto vacío responde 200 con listas vacías.
}
