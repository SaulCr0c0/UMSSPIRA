        ],
        "request": {
          "method": "POST",
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "body": {
            "mode": "raw",
            "raw": "{\n  \"registrationId\": \"{{attemptRegistrationId}}\",\n  \"code\": \"{{invalidCode}}\"\n}"
          },
          "url": {
            "raw": "{{baseUrl}}/api/email-verification/verify",
            "host": ["{{baseUrl}}"],
            "path": ["api", "email-verification", "verify"]
          },
        "description": "Precondición: usar el mismo attemptRegistrationId con un OTP activo y el mismo invalidCode durante los cinco primeros intentos."
        }
