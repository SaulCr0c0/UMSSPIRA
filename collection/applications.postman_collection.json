{
  "info": {
    "_postman_id": "01de462d-ccb6-556f-a2a8-2e96b3f4bbdf",
    "name": "UMSSPIRA - Bandeja de solicitudes (HU-04)",
    "description": "GET /api/applications: bandeja paginada (15 filas), filtros por carrera/estado, buscador y alerta +48h (CA-04.1, CA-04.2). Detalle del expediente y URL firmada del documento (CA-04.3).\n\nTodas las rutas exigen JWT de administrador: variable adminToken. El applicationId se guarda solo desde el listado.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "CA-04.1 - Bandeja paginada",
      "item": [
        {
          "name": "Listar primera página (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));",
                  "const { data } = pm.response.json();",
                  "pm.test('Pagina con items y total', () => { pm.expect(data.items).to.be.an('array'); pm.expect(data.total).to.be.a('number'); pm.expect(data.items.length).to.be.at.most(15); });",
                  "pm.test('Orden CA-04.1: pendientes primero', () => { const firstNonPending = data.items.findIndex(i => i.status !== 'PENDING'); const pendingAfter = data.items.findIndex((i, idx) => idx > firstNonPending && i.status === 'PENDING'); pm.expect(firstNonPending === -1 || pendingAfter === -1).to.be.true; });",
                  "if (data.items.length > 0) { pm.collectionVariables.set('applicationId', data.items[0].id); }"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/applications",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "applications"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "pageSize",
                  "value": "15"
                }
              ]
            },
            "description": "Bandeja con 15 filas máximo. Requiere JWT de administrador en adminToken."
          },
          "response": []
        },
