          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"profile\": {\n    \"userId\": \"30000000-0000-4000-8000-000000000001\",\n    \"isMentorActive\": false,\n    \"isGraduate\": true,\n    \"isVerified\": true,\n    \"isApproved\": true,\n    \"hasParticipationRestriction\": false,\n    \"personalInfo\": {\n      \"firstName\": \"Lucia\",\n      \"lastName\": \"Rojas\",\n      \"email\": \"lucia.rojas@example.test\",\n      \"phone\": \"+591 70000001\"\n    },\n    \"academicInfo\": {\n      \"career\": \"Ingenieria de Sistemas\",\n      \"degree\": \"Licenciatura\",\n      \"graduationYear\": 2021\n    },\n    \"professionalInfo\": {\n      \"summary\": \"Desarrolladora backend con experiencia en APIs.\",\n      \"yearsExperience\": 4\n    },\n    \"description\": \"Mentora de sistemas distribuidos.\",\n    \"experienceDescription\": \"Experiencia en APIs, PostgreSQL y servicios en la nube.\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/mentorship/eligibility"
          }
        },
        {
          "name": "Evaluar perfil vacío e inválido",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Se informan todos los datos faltantes e inválidos', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const result = pm.response.json();",
                  "  pm.expect(result.eligible).to.eql(false);",
                  "  const incomplete = result.issues.find(issue => issue.code === 'profile_incomplete');",
                  "  const invalid = result.issues.find(issue => issue.code === 'invalid_profile_data');",
                  "  pm.expect(incomplete.missingFields).to.include('Nombre');",
                  "  pm.expect(incomplete.missingFields).to.include('Carrera');",
                  "  pm.expect(invalid.invalidFields).to.include('Estado activo del mentor');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
