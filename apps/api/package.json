{
  "name": "api",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "nest start --watch",
    "dev:local": "SUPABASE_ENV=local nest start --watch",
    "build": "nest build",
    "test": "pnpm run test:node && pnpm run test:jest",
    "test:interests": "npm run build && node --test test/mentorship-interests.e2e.cjs",
    "test:profile-info": "npm run build && node --test test/mentorship-profile-information.test.cjs",
    "lint": "eslint src --ext .ts",
    "start": "node dist/main",
    "test:watch": "jest --config jest.config.js --watch",
    "test:node": "npm run build && node --test \"dist/modules/reports/**/*.spec.js\"",
    "test:jest": "jest --config jest.config.js"
  },
  "dependencies": {
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^10.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "@supabase/supabase-js": "^2.117.2",
    "@umsspira/shared-types": "workspace:*",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^18.0.5",
    "pdfmake": "^0.2.23",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "ioredis": "^6.0.0",
    "nodemailer": "^10.0.14",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/passport": "^12.0.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^20.0.0",
    "@types/pdfmake": "^0.2.13",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^10.12.0",
    "typescript": "^5.1.3",
    "typescript-eslint": "^8.71.0",
    "@types/jest": "29.5.14",
    "@types/nodemailer": "^8.0.2",
    "jest": "29.7.0",
    "ts-jest": "29.2.5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.23.1",
    "jsonwebtoken": "^9.0.3"
  }
}
