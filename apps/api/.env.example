# Copiar a apps/api/.env y completar (ver README). El .env nunca se sube a git.

# --- Base de datos (Supabase, proyecto UMSSPIRA) ---
# Supabase > Connect > Session pooler (funciona con IPv4; la conexión directa db.<ref>.supabase.co es solo IPv6).
# Formato: postgresql://postgres.<ref>:<CONTRASENIA_BD>@<host-del-pooler>:5432/postgres (copiarla tal cual de Supabase)
# Para el stack local de Supabase (SUPABASE_ENV=local): postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_URL=
# Opcional: "false" desactiva SSL (por defecto se usa SSL salvo con localhost)
DATABASE_SSL=

# --- Supabase Storage (respaldos de certificaciones) ---
# Supabase > Project Settings > API
SUPABASE_URL=https://mcgsfoorjpusbjllmvjr.supabase.co
# Clave service_role (secreta, solo backend). No usar la anon: con RLS activo no puede subir archivos.
SUPABASE_SERVICE_ROLE_KEY=

# --- Perfil (Épica 2) ---
# Mientras no exista el login, la API actúa como este titulado. Titulado de ejemplo cargado en Supabase:
TITULADO_ID_PRUEBA=9bab2c02-d99b-4e06-a16c-ba5ee762654e
